  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "es2020",
      "dom"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "moov-faststart": [
        "../types/moov-faststart.d.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
