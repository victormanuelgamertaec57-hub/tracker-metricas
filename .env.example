# Variables de entorno para las Netlify Functions
# Copia este archivo como .env y completa los valores reales
# NUNCA commitees el archivo .env — ya está en .gitignore

# Token de acceso de Meta Graph API con permiso ads_read
# Generarlo en: Meta Business Manager → Configuración → Tokens de acceso
META_ACCESS_TOKEN=

# ID de la cuenta publicitaria (con prefijo "act_")
# Lo encuentras en Meta Ads Manager → Configuración de la cuenta
META_AD_ACCOUNT_ID=act_3586753551478114

# Secreto compartido para autenticar las llamadas del frontend a las
# Netlify Functions. Genera un valor random largo y ponlo en ambas variables
# (deben tener el MISMO valor). Ejemplo:
#   openssl rand -hex 32
# Configúralo también en Netlify → Site settings → Environment variables.
APP_SECRET=
VITE_APP_SECRET=

# --- Análisis de creativos con IA (solo backend, NUNCA con prefijo VITE_) ---

# API Key de Google Gemini (modelo gemini-3.8-flash para análisis de video)
# Generarla en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API Key de Anthropic/Claude (modelo claude-sonnet-5 para análisis estratégico)
# Generarla en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
